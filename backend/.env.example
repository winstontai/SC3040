# Copy to backend/.env and fill in. backend/.env is git-ignored - never commit a real key.

# OpenAI API key for the AI chatbot (https://platform.openai.com/api-keys)
# Leave empty to run in scaffold mode: the chatbot replies with a placeholder.
OPENAI_API_KEY=

# Optional: model to use (default gpt-6-luna). e.g. gpt-6.1-sol for better answers at higher cost
# OPENAI_MODEL=gpt-6-luna
